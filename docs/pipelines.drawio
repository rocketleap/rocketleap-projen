        <mxCell id="c34" value="&lt;b&gt;.projenrc.ts&lt;/b&gt;&lt;br&gt;pipeline:&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;promotionStrategy:&amp;nbsp;PromotionStrategy.DIRECT,&lt;br&gt;&amp;nbsp;&amp;nbsp;stages:&amp;nbsp;[&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;environment:&amp;nbsp;'dev'&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;environment:&amp;nbsp;'staging'&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;environment:&amp;nbsp;'prod-eu'&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;environment:&amp;nbsp;'prod-us'&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;}" style="text;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;" parent="1" vertex="1">
