        <mxCell id="c83" value="Workloads in the same environment deploy in parallel behind one gate. Wave 'platform' deploys first; wave 'prod' starts once it succeeded." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="40" y="580" width="1200" height="50" as="geometry" />
