        <mxCell id="c33" value="Every push deploys all stages in sequence. Each gate is a GitHub Environment job named after the environment." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" parent="1" vertex="1">
