        <mxCell id="c22" value="&lt;b&gt;pipeline stage options&lt;/b&gt;&lt;br&gt;promotion:&amp;nbsp;true&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;deploys&amp;nbsp;from&amp;nbsp;production&amp;nbsp;after&amp;nbsp;the&amp;nbsp;promotion&amp;nbsp;PR&lt;br&gt;wave:&amp;nbsp;'&amp;lt;name&amp;gt;'&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;consecutive&amp;nbsp;stages&amp;nbsp;deploy&amp;nbsp;in&amp;nbsp;parallel&amp;nbsp;behind&amp;nbsp;one&amp;nbsp;gate&amp;nbsp;on&amp;nbsp;the&amp;nbsp;GitHub&amp;nbsp;Environment&amp;nbsp;&amp;lt;name&amp;gt;&lt;br&gt;diff:&amp;nbsp;false&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;stage&amp;nbsp;skipped&amp;nbsp;on&amp;nbsp;PR&amp;nbsp;diffs&lt;br&gt;promotionStrategy:&amp;nbsp;DIRECT&amp;nbsp;&amp;nbsp;single&amp;nbsp;trunk,&amp;nbsp;every&amp;nbsp;stage&amp;nbsp;from&amp;nbsp;main&amp;nbsp;and&amp;nbsp;dev" style="text;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;" parent="1" vertex="1">
