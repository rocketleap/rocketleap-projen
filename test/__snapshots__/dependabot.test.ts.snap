// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Workload project auto-generates .github/dependabot.yml 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.ts and run "npx projen".

version: 2
updates:
  - package-ecosystem: 'npm'
    directory: '/'
    schedule:
      interval: 'monthly'
      day: 'monday'
      time: '04:00'
      timezone: Europe/Amsterdam
    groups:
      dependabot:
        patterns:
          - '*'
    ignore:
      - dependency-name: "eslint"
      - dependency-name: "@eslint/*"
      - dependency-name: "eslint-*"
      - dependency-name: "typescript"
      # Pinned by rocketleap-projen to match @rocketleap/building-blocks-cdk peer deps.
      # Allowing dependabot to bump these would violate the peer-dep contract.
      - dependency-name: "aws-cdk-lib"
      - dependency-name: "constructs"
    registries:
      - private

registries:
  private:
    type: npm-registry
    url: https://npm.pkg.github.com
    token: \${{ secrets.DEPENDABOT_GITHUB_TOKEN }}"
`;
