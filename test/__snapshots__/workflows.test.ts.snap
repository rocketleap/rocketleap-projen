exports[`generated workflow snapshots direct pipeline: .github/workflows/action-synth.yml 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

name: "Action: Synth Environment"
on:
  workflow_call:
    inputs:
      environment:
        type: string
        required: true
      workload:
        type: string
        required: false
env:
  GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
permissions:
  actions: write
  contents: read
  packages: read
jobs:
  synth:
    runs-on: ubuntu-latest
    steps:
      - name: Download build workspace
        uses: actions/download-artifact@v4
        with:
          name: build-workspace
          path: .
      - name: Enable Corepack
        run: corepack enable
      - uses: actions/setup-node@v6
        with:
          node-version: "24"
          cache: yarn
      - run: yarn
      - name: Set paths
        shell: bash
        run: |-
          if [ "\${{inputs.workload}}" == "" ]; then
            echo 'cdk_out_dir=cdk.out/\${{inputs.environment}}' >> "$GITHUB_ENV"
            echo 'artifact_name=cdk-out-\${{inputs.environment}}' >> "$GITHUB_ENV"
          else
            echo 'cdk_out_dir=cdk.out/\${{inputs.environment}}/\${{inputs.workload}}' >> "$GITHUB_ENV"
            echo 'artifact_name=cdk-out-\${{inputs.environment}}-\${{inputs.workload}}' >> "$GITHUB_ENV"
          fi
      - name: Synth
        run: yarn synth "\${{ inputs.workload && format('{0}/{1}', inputs.environment, inputs.workload) || inputs.environment }}"
      - name: Upload cdk.out
        uses: actions/upload-artifact@v4
        with:
          name: \${{ env.artifact_name }}
          path: \${{ env.cdk_out_dir }}
          retention-days: 7
          if-no-files-found: error
"
`;

exports[`generated workflow snapshots direct pipeline: .github/workflows/pr-main.yml 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

name: "PR: Main Branch"
on:
  pull_request:
    branches:
      - main
      - dev
concurrency:
  group: pr-main-\${{ github.ref }}
  cancel-in-progress: true
permissions:
  actions: write
  pull-requests: write
  contents: read
  packages: read
  id-token: write
jobs:
  build:
    name: Build
    uses: ./.github/workflows/action-build.yml
  synth:
    name: Synth \${{ matrix.stage.environment }}\${{ matrix.stage.workload && format(' ({0})', matrix.stage.workload) || '' }}
    needs: build
    strategy:
      fail-fast: true
      matrix:
        stage:
          - environment: dev
          - environment: staging
          - environment: prodeu
          - environment: produs
    uses: ./.github/workflows/action-synth.yml
    with:
      environment: \${{ matrix.stage.environment }}
      workload: \${{ matrix.stage.workload }}
  diff-dev-0:
    name: Diff dev
    needs:
      - synth
    uses: ./.github/workflows/action-diff.yml
    with:
      job-name: Diff dev
      environment: dev
  diff-staging-1:
    name: Diff staging
    needs:
      - synth
    uses: ./.github/workflows/action-diff.yml
    with:
      job-name: Diff staging
      environment: staging
  diff-prodeu-2:
    name: Diff prodeu
    needs:
      - synth
    uses: ./.github/workflows/action-diff.yml
    with:
      job-name: Diff prodeu
      environment: prodeu
  diff-produs-3:
    name: Diff produs
    needs:
      - synth
    uses: ./.github/workflows/action-diff.yml
    with:
      job-name: Diff produs
      environment: produs
"
`;

exports[`generated workflow snapshots direct pipeline: .github/workflows/push-main.yml 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

name: "Push: Main Branch"
on:
  push:
    branches:
      - main
      - dev
  workflow_dispatch: {}
permissions:
  actions: write
  contents: write
  packages: read
  id-token: write
  pull-requests: write
concurrency: main
jobs:
  build:
    name: Build
    uses: ./.github/workflows/action-build.yml
  synth:
    name: Synth \${{ matrix.stage.environment }}\${{ matrix.stage.workload && format(' ({0})', matrix.stage.workload) || '' }}
    needs: build
    strategy:
      fail-fast: false
      matrix:
        stage:
          - environment: dev
          - environment: staging
          - environment: prodeu
          - environment: produs
    uses: ./.github/workflows/action-synth.yml
    with:
      environment: \${{ matrix.stage.environment }}
      workload: \${{ matrix.stage.workload }}
  gate-dev-0:
    name: Await approval for dev
    needs:
      - synth
    runs-on: ubuntu-latest
    environment: dev
    steps:
      - run: echo "Approved — starting deploys to dev"
  deploy-dev-0:
    name: Deploy dev
    needs:
      - gate-dev-0
    uses: ./.github/workflows/action-deploy.yml
    with:
      environment: dev
  gate-staging-1:
    name: Await approval for staging
    needs:
      - deploy-dev-0
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - run: echo "Approved — starting deploys to staging"
  deploy-staging-1:
    name: Deploy staging
    needs:
      - gate-staging-1
    uses: ./.github/workflows/action-deploy.yml
    with:
      environment: staging
  gate-prodeu-2:
    name: Await approval for prodeu
    needs:
      - deploy-staging-1
    runs-on: ubuntu-latest
    environment: prodeu
    steps:
      - run: echo "Approved — starting deploys to prodeu"
  deploy-prodeu-2:
    name: Deploy prodeu
    needs:
      - gate-prodeu-2
    uses: ./.github/workflows/action-deploy.yml
    with:
      environment: prodeu
  gate-produs-3:
    name: Await approval for produs
    needs:
      - deploy-prodeu-2
    runs-on: ubuntu-latest
    environment: produs
    steps:
      - run: echo "Approved — starting deploys to produs"
  deploy-produs-3:
    name: Deploy produs
    needs:
      - gate-produs-3
    uses: ./.github/workflows/action-deploy.yml
    with:
      environment: produs
"
`;

