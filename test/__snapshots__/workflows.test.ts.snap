"# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

name: "Push: Dev Branch"
on:
  push:
    branches:
      - dev
  workflow_dispatch: {}
permissions:
  actions: write
  contents: write
  packages: read
  id-token: write
  pull-requests: write
concurrency: dev
jobs:
  build:
    name: Build
    uses: ./.github/workflows/action-build.yml
  build-python:
    name: Build Python
    uses: ./.github/workflows/action-build-python.yml
  synth:
    name: Synth \${{ matrix.stage.environment }}\${{ matrix.stage.workload && format(' ({0})', matrix.stage.workload) || '' }}
    needs:
      - build
      - build-python
    strategy:
      fail-fast: false
      matrix:
        stage:
          - environment: dev
          - environment: staging
    uses: ./.github/workflows/action-synth.yml
    with:
      environment: \${{ matrix.stage.environment }}
      workload: \${{ matrix.stage.workload }}
  gate-dev-0:
    name: Await approval for dev
    needs:
      - synth
    runs-on: ubuntu-latest
    environment: dev
    steps:
      - run: echo "Approved — starting deploys to dev"
  deploy-dev-0:
    name: Deploy dev
    needs:
      - gate-dev-0
    uses: ./.github/workflows/action-deploy.yml
    with:
      environment: dev
  gate-staging-1:
    name: Await approval for staging
    needs:
      - deploy-dev-0
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - run: echo "Approved — starting deploys to staging"
  deploy-staging-1:
    name: Deploy staging
    needs:
      - gate-staging-1
    uses: ./.github/workflows/action-deploy.yml
    with:
      environment: staging
  promote:
    name: Create main promotion PR
    needs:
      - deploy-staging-1
    uses: ./.github/workflows/action-promote-pr.yml
    with:
      target-branch: main
      source-branch: \${{ github.ref_name }}
"
`;

